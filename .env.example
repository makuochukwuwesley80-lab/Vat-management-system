# ---------------------------------------------------------------------------
# VAT Management System — environment variables
# Copy this file to `.env.local` for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.
#
# PUBLIC variables are safe for the browser. SERVER-ONLY variables must
# never be committed or exposed to the client bundle.
# ---------------------------------------------------------------------------

# --- PUBLIC (safe in browser; these identify your Supabase project) ---------
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# --- SERVER-ONLY (never expose to the browser) ------------------------------
# Used only inside server actions to provision worker/foster-parent auth
# accounts. Find it in Supabase Dashboard → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used by the Vercel cron endpoint that flags missing attendance
# submissions after 12:00 noon WAT. Choose any long random string.
CRON_SECRET=choose-a-long-random-string

# OPTIONAL: absolute URL of the deployment, used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
